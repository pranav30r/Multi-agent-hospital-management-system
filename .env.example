# ============================================================================
# HOSPITAL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================

# Database Configuration
# Local SQLite fallback: sqlite+aiosqlite:///./hospital.db
# Production PostgreSQL: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/hospital_db
DATABASE_URL=sqlite+aiosqlite:///./hospital.db

# Redis Pub-Sub & Event Cache
REDIS_URL=redis://localhost:6379/0

# Security & JWT Configuration
JWT_SECRET=hospital-enterprise-super-secret-jwt-key-2026-secure-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment Mode (DEVELOPMENT, STAGING, PRODUCTION)
ENVIRONMENT=DEVELOPMENT
PROJECT_NAME=Multi-Agent Hospital Resource & Patient Management System

# AI Agent LLM API Keys (Person 2 scope)
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
