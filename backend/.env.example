# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Multi-Agent Hospital System"
API_V1_STR=/api/v1

# Security & JWT (Must be set to a high-entropy secret in production)
SECRET_KEY=hospital-super-secret-key-change-in-production-2026
JWT_SECRET=hospital-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configurable CORS Origins (comma-separated list of allowed web/mobile origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database Connection (PostgreSQL with SQLite async fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/hospital

# Redis (Caching & Task Queue)
REDIS_URL=redis://localhost:6379/0

# Optional LLM API Keys
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gpt-4o-mini
ENABLE_LLM_FALLBACK=true
SIMULATION_TIME_ACCELERATION=1.0
